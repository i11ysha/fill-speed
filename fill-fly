-- ПЕРЕТАСКИВАНИЕ
local dragging = false
local dragStart, startPos

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- SPEED ЛОГИКА
local speed = 16
local defaultSpeed = 16

local function setSpeed(s)
    speed = s
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = speed
    end
end

textBox.FocusLost:Connect(function(enter)
    if enter then
        local n = tonumber(textBox.Text)
        if n then
            setSpeed(n)
        end
    end
end)

button.MouseButton1Click:Connect(function()
    setSpeed(defaultSpeed)
    textBox.Text = tostring(defaultSpeed)
end)

RunService.Stepped:Connect(function()
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = speed
    end
end)

-- FLING ЛОГИКА
local flingEnabled = false
local lastPos

local function fling()
    local m = 0.1
    while flingEnabled do
        RunService.Heartbeat:Wait()
        local h = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if h then
            if lastPos and (h.Position - lastPos).Magnitude > 10 then
                lastPos = h.Position
                continue
            end
            lastPos = h.Position

            local v = h.Velocity
            h.Velocity = v * 1e4 + Vector3.new(0, 1e4, 0)
            RunService.RenderStepped:Wait()
            h.Velocity = v
            RunService.Stepped:Wait()
            h.Velocity = v + Vector3.new(0, m, 0)
            m = -m
        end
    end
end

local function toggleFling()
    flingEnabled = not flingEnabled
    flingBtn.Text = flingEnabled and "FLING ON" or "FLING"
    if flingEnabled then
        task.spawn(fling)
    end
end

flingBtn.MouseButton1Click:Connect(toggleFling)

-- КЛАВИШИ
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end

    if input.KeyCode == Enum.KeyCode.T then
        toggleFling()
    end

    if input.KeyCode == Enum.KeyCode.V then
        gui.Enabled = not gui.Enabled
    end
end)
